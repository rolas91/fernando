PORT=3000
NODE_ENV=production

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fernando

# Use a secure random secret in production
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=7d

SWAGGER_ENABLED=false
DEFAULT_ROLE_KEY=user

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Set your real frontend domain(s), comma separated
CORS_ORIGIN=https://your-frontend-domain.com
SERVE_FRONTEND=true
FRONTEND_DIST_PATH=/app/public

# Production strict mode: enforce JWT and role checks
AUTH_DEV_BYPASS=false

TWILIO_ACCOUNT_SID=placeholder-twilio-sid
TWILIO_AUTH_TOKEN=placeholder-twilio-token
TWILIO_FROM_NUMBER=+10000000000
TWILIO_WHATSAPP_FROM=
# TWILIO_WHATSAPP_CONTENT_SID=
# TWILIO_WHATSAPP_TEMPLATE_VAR_MODE=full

SMTP_HOST=placeholder.smtp.host
SMTP_PORT=587
SMTP_USER=placeholder@example.com
SMTP_PASS=placeholder-password
SMTP_FROM=no-reply@example.com

GEOCODING_PROVIDER=placeholder
GEOCODING_API_KEY=placeholder-geocoding-key

# Mandatory mobile updates: use off to bypass enforcement, or leave empty to use automatic policy.
MOBILE_IOS_MIN_VERSION=
MOBILE_IOS_STORE_URL=
MOBILE_ANDROID_MIN_VERSION=
MOBILE_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.drtrafficcontrol.mobile

# Optional store synchronization. Set countries to the storefronts your users rely on.
MOBILE_IOS_AUTO_UPDATE=false
MOBILE_IOS_STORE_COUNTRIES=
MOBILE_ANDROID_AUTO_UPDATE=false
MOBILE_ANDROID_STORE_COUNTRIES=
# JSON mapping from Google Play versionCode to the binary version, e.g. {"42":"1.0.5"}.
MOBILE_ANDROID_VERSION_CODES=
MOBILE_APPLE_APP_ID=
MOBILE_APPLE_ISSUER_ID=
MOBILE_APPLE_KEY_ID=
# Base64 of the complete .p8 file, on a single line. Base64 is not encryption.
MOBILE_APPLE_PRIVATE_KEY_BASE64=
MOBILE_GOOGLE_PACKAGE_NAME=com.drtrafficcontrol.mobile
# Base64 of the complete service-account JSON file, on a single line.
MOBILE_GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
