# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:24-bookworm-slim AS production-dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

FROM node:24-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=3000 DB_SYNCHRONIZE=false AUTH_DEV_BYPASS=false SERVE_FRONTEND=false
# Empty defaults are overridable at runtime; never bake store credentials into the image.
# Store credential variables are reserved until synchronization is implemented.
ENV MOBILE_IOS_MIN_VERSION="" \
    MOBILE_IOS_STORE_URL="" \
    MOBILE_ANDROID_MIN_VERSION="" \
    MOBILE_ANDROID_STORE_URL="https://play.google.com/store/apps/details?id=com.drtrafficcontrol.mobile" \
    MOBILE_APPLE_APP_ID="" \
    MOBILE_APPLE_ISSUER_ID="" \
    MOBILE_APPLE_KEY_ID="" \
    MOBILE_APPLE_PRIVATE_KEY_BASE64="" \
    MOBILE_GOOGLE_PACKAGE_NAME="com.drtrafficcontrol.mobile" \
    MOBILE_GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=""
COPY --from=production-dependencies --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --chown=node:node scripts/container-healthcheck.cjs ./scripts/container-healthcheck.cjs
COPY --chmod=755 deploy/docker-entrypoint.sh ./docker-entrypoint.sh
RUN mkdir -p /app/public && chown node:node /app/public
USER node
EXPOSE 3000
HEALTHCHECK --interval=20s --timeout=6s --start-period=60s --retries=5 CMD ["node", "scripts/container-healthcheck.cjs"]
ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["node", "dist/main.js"]
