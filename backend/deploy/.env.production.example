# Keep this file on the VPS as .env.production with chmod 600.
# Supply a DNS name pointing at this VPS; ports 80/443 must be available.
APP_DOMAIN=workops.example.com
ACME_EMAIL=admin@example.com
WEB_PORT=8080
# Use external when an existing HTTPS reverse proxy already owns ports 80/443.
EDGE_PROXY=caddy
# Existing PostgreSQL instance. No production database is created by Compose.
DB_HOST=your-database-host
DB_PORT=5432
DB_USER=your-database-user
DB_PASSWORD=replace-with-database-password
DB_NAME=your-existing-database
DB_SYNCHRONIZE=false
DB_LOGGING=false
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=12h
AUTH_DEV_BYPASS=false
SWAGGER_ENABLED=false
SERVE_FRONTEND=false
CORS_ORIGIN=https://workops.example.com
PASSWORD_RESET_WEB_URL=https://workops.example.com/reset-password
BUSINESS_TIME_ZONE=America/Los_Angeles
# Retain existing email, storage, notification and integration settings below.
# SMTP_*, SENDGRID_*, TWILIO_*, SPACES_* etc: copy their values directly on the VPS.

# Mandatory mobile updates: use off to bypass enforcement, or leave empty to use automatic policy.
MOBILE_IOS_MIN_VERSION=
MOBILE_IOS_STORE_URL=
MOBILE_ANDROID_MIN_VERSION=
MOBILE_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.drtrafficcontrol.mobile

# Optional store synchronization. Set countries to the storefronts your users rely on.
MOBILE_IOS_AUTO_UPDATE=false
MOBILE_IOS_STORE_COUNTRIES=
MOBILE_ANDROID_AUTO_UPDATE=false
MOBILE_ANDROID_STORE_COUNTRIES=
# JSON mapping from Google Play versionCode to the binary version, e.g. {"42":"1.0.5"}.
MOBILE_ANDROID_VERSION_CODES=
MOBILE_APPLE_APP_ID=
MOBILE_APPLE_ISSUER_ID=
MOBILE_APPLE_KEY_ID=
# Base64 of the complete .p8 file, on a single line. Base64 is not encryption.
MOBILE_APPLE_PRIVATE_KEY_BASE64=
MOBILE_GOOGLE_PACKAGE_NAME=com.drtrafficcontrol.mobile
# Base64 of the complete service-account JSON file, on a single line.
MOBILE_GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
