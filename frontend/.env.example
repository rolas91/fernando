# URL base del backend (sin / al final). Ej:
# VITE_API_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000

# URL opcional para websocket realtime
# Si se omite, usa VITE_API_URL
VITE_REALTIME_URL=http://localhost:3000

# Google Maps JS (autocomplete + reverse geocode). Enables Places + Geocoder in the Assignment Address field.
# VITE_GOOGLE_MAPS_API_KEY=
# Enable in Google Cloud for that key: Maps JavaScript API, Places API, and Geocoding API.
