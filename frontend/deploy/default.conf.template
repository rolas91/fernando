map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}
map $http_x_forwarded_proto $forwarded_proto { default $http_x_forwarded_proto; '' $scheme; }
server {
  listen 8080;
  server_name _;
  resolver 127.0.0.11 valid=5s ipv6=off;
  set $api_upstream "${API_UPSTREAM}";
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 100m;
  location = /healthz { access_log off; default_type text/plain; return 200 'ok'; }
  location = /api-healthz {
    proxy_pass http://$api_upstream/healthz;
    proxy_set_header Host $host;
  }
  location ~ ^/(api|files|socket.io|realtime)(/|$) {
    proxy_pass http://$api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
  }
  location / { try_files $uri $uri/ /index.html; }
}
