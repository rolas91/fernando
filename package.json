{
  "name": "dr-workops-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Nx monorepo for WorkOps frontend, backend and mobile",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "nx": "node scripts/nx.cjs",
    "projects": "node scripts/nx.cjs show projects",
    "graph": "node scripts/nx.cjs graph",
    "dev": "node scripts/nx.cjs run-many -t dev -p frontend backend --parallel=2 --outputStyle=stream",
    "dev:frontend": "node scripts/nx.cjs run frontend:dev",
    "dev:backend": "node scripts/nx.cjs run backend:dev",
    "dev:mobile": "node scripts/nx.cjs run mobile:dev",
    "dev:all": "node scripts/nx.cjs run-many -t dev -p frontend backend mobile --parallel=3 --outputStyle=stream",
    "mobile:android": "node scripts/nx.cjs run mobile:android",
    "mobile:ios": "node scripts/nx.cjs run mobile:ios",
    "mobile:web": "node scripts/nx.cjs run mobile:web",
    "build": "node scripts/nx.cjs run-many -t build -p frontend backend --parallel=2",
    "build:frontend": "node scripts/nx.cjs run frontend:build",
    "build:backend": "node scripts/nx.cjs run backend:build",
    "build:mobile:web": "node scripts/nx.cjs run mobile:build-web",
    "build:android": "node scripts/nx.cjs run mobile:build-android",
    "build:ios": "node scripts/nx.cjs run mobile:build-ios",
    "typecheck": "node scripts/nx.cjs run-many -t typecheck -p frontend backend mobile --parallel=3",
    "test": "node scripts/nx.cjs run-many -t test -p frontend backend mobile --parallel=1",
    "test:frontend": "node scripts/nx.cjs run frontend:test",
    "test:backend": "node scripts/nx.cjs run backend:test",
    "test:mobile": "node scripts/nx.cjs run mobile:test",
    "lint": "node scripts/nx.cjs run-many -t lint -p frontend backend mobile --parallel=3",
    "install:projects": "node scripts/install-projects.cjs",
    "db:migrate": "node scripts/nx.cjs run backend:migrate",
    "db:revert": "node scripts/nx.cjs run backend:migrate-revert",
    "docker:config": "docker compose --env-file .env.docker.example config --quiet",
    "docker:up": "docker compose --env-file .env.docker up -d --build --wait",
    "docker:down": "docker compose --env-file .env.docker down",
    "docker:logs": "docker compose --env-file .env.docker logs -f --tail=100",
    "docker:migrate": "docker compose --env-file .env.docker run --rm --build migrate",
    "docker:build": "docker compose --env-file .env.docker build",
    "check:workspace": "node --test scripts/workspace.test.cjs scripts/security-dependencies.test.cjs",
    "dev:local": "node scripts/run-local.cjs",
    "docker:db": "docker compose --env-file .env.docker up -d --wait db",
    "docker:seed": "docker compose --env-file .env.docker run --rm --build api node dist/database/seed-iam.js",
    "prepare:monorepo": "node scripts/prepare-monorepo.cjs"
  },
  "devDependencies": {
    "nx": "24.0.5",
    "yaml": "2.9.1"
  }
}
